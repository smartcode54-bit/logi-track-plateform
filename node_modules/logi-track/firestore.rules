rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Hub→SOC distances (Google Distance Matrix cache). Read by web map & mobile; write via Admin API only.
    match /hub_soc_distances/{docId} {
      allow read: if request.time < timestamp.date(2026, 3, 10);
      allow write: if request.time < timestamp.date(2026, 3, 10);
    }
    // SOC→Hub distances (Google Distance Matrix cache). Read by web map & mobile; write via Admin API only.
    match /soc_hub_distances/{docId} {
      allow read: if request.time < timestamp.date(2026, 3, 10);
      allow write: if request.time < timestamp.date(2026, 3, 10);
    }

    // Users: drivers can read/write their own doc (e.g. fcmTokens). Admins need full access via token.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Chats: Admins read all chats; drivers only their own (driverId == authId).
    // status, assignedAdminId, priority, lastReadByAdmin (Map), lastMessage, lastMessageAt.
    match /chats/{chatId} {
      allow read: if request.auth != null && (
        request.auth.token.admin == true ||
        resource.data.driverId == request.auth.uid
      );
      allow create: if request.auth != null && (
        request.auth.token.admin == true ||
        (request.resource.data.driverId == request.auth.uid && request.resource.data.assignedAdminId == null)
      );
      allow update, delete: if request.auth != null && (
        request.auth.token.admin == true ||
        resource.data.driverId == request.auth.uid
      );

      // Messages subcollection: same visibility as parent chat.
      match /messages/{messageId} {
        allow read, write: if request.auth != null && (
          request.auth.token.admin == true ||
          get(/databases/$(database)/documents/chats/$(chatId)).data.driverId == request.auth.uid
        );
      }
    }

    // Incident reports: drivers create/read own; admins can create (e.g. Report Incident from Command Center) and read.
    match /incidentReport/{reportId} {
      allow read: if request.auth != null && (
        request.auth.token.admin == true ||
        resource.data.driverId == request.auth.uid
      );
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        request.auth.token.admin == true ||
        resource.data.driverId == request.auth.uid
      );
    }

    // Broadcasts: history of sent broadcasts. Drivers can read (for Broadcast list); only admins can write.
    match /broadcasts/{broadcastId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Customers / LSP profiles (for billing, driver IDs). Admin only.
    match /customers/{customerId} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }

    // Unified Tasks (formerly first_mile_tasks): Admins write; Drivers read/update (e.g. checkin status).
    match /tasks/{taskId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.token.admin == true ||
        request.resource.data.driverId == request.auth.uid ||
        resource.data.driverId == request.auth.uid
      );
    }

    // Unified Check-in records: Drivers create/read own; Admins read all.
    match /checkin/{checkinId} {
      allow read: if request.auth != null && (
        request.auth.token.admin == true ||
        resource.data.driverId == request.auth.uid
      );
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        request.auth.token.admin == true ||
        resource.data.driverId == request.auth.uid
      );
    }

    // Role-permission config: admin only
    match /permissions_config/{roleId} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }

    // Legacy permissive rule (expires); keep other collections working until migrated.
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 3, 10);
    }
  }
}
