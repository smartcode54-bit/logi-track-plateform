# =============================================================================
# Dev environment for Flutter (LogiTrack Mobile) — logi-track-wrt-dev
# =============================================================================
# Copy to envs/.env.dev.mobile and fill with real values (never commit .env.dev.mobile)
#   copy envs\.env.dev.mobile.example envs\.env.dev.mobile
# To use: copy envs/.env.dev.mobile to logitrack-mobile/.env.dev before running the app (dev flavor).
# =============================================================================

FIREBASE_API_KEY=
FIREBASE_APP_ID_WEB=
FIREBASE_PROJECT_ID=logi-track-wrt-dev
FIREBASE_AUTH_DOMAIN=logi-track-wrt-dev.firebaseapp.com
FIREBASE_STORAGE_BUCKET=logi-track-wrt-dev.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_MEASUREMENT_ID=

# Google Sign-In (OAuth client ID for Web)
FIREBASE_WEB_CLIENT_ID=

# Optional: Maps (photo overlay), Vision (OCR)
GOOGLE_MAPS_API_KEY=
GOOGLE_CLOUD_VISION_API_KEY=


CARTRACK_API_USERNAME=
CARTRACK_API_PASSWORD=
CARTRACK_SYNC_ENABLED=true