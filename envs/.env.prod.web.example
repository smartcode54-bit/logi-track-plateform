# =============================================================================
# Production environment template for Next.js (LogiTrack Web) — logitrack-prod
# =============================================================================
# Copy to envs/.env.prod.web and fill with real values (never commit .env.prod.web)
#   cp envs/.env.prod.web.example envs/.env.prod.web
# =============================================================================

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=logitrack-prod.web.app
NEXT_PUBLIC_FIREBASE_PROJECT_ID=logitrack-prod
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=logitrack-prod.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

FIREBASE_WEB_CLIENT_ID=
# Optional (if used by app):
# GOOGLE_MAPS_API_KEY=
# GOOGLE_CLOUD_VISION_API_KEY=
# CARTRACK_API_USERNAME=
# CARTRACK_API_PASSWORD=
# CARTRACK_PILOT_VEHICLE_IDS=
# CARTRACK_SYNC_ENABLED=true
