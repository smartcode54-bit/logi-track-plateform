# =============================================================================
# Dev environment for Next.js (LogiTrack Web) — local / dev project
# =============================================================================
# Copy to envs/.env.dev.web and fill with real values (never commit .env.dev.web)
#   copy envs\.env.dev.web.example envs\.env.dev.web
# When you run "pnpm run dev" from repo root, this file is copied to logitrack-web/.env.local if .env.local is missing.
# =============================================================================

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# App Check (reCAPTCHA v3 or Enterprise)
# 1. Register your site in reCAPTCHA admin console to get a site key.
# 2. For localhost debug, set NEXT_PUBLIC_APP_CHECK_DEBUG_TOKEN to a token from the browser console.
NEXT_PUBLIC_APP_CHECK_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_APP_CHECK_USE_ENTERPRISE=false
NEXT_PUBLIC_APP_CHECK_DEBUG_TOKEN=

