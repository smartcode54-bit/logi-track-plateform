# mv-go test app (flavor gotest, package com.wrt.logitrack.gotest) — read by scripts/build-mobile-gotest.mjs
# Copy to envs/.env.gotest.mobile (gitignored). Firebase values come from envs/.env.dev.mobile (gotest = Firebase dev).
#   copy envs\.env.gotest.mobile.example envs\.env.gotest.mobile
# Also needed (gitignored): logitrack-mobile/android/app/src/gotest/google-services.json — Firebase dev ->
#   Project settings -> Android app com.wrt.logitrack.gotest -> google-services.json (add your machine's debug SHA first).

# Go staging API (the staging VM, PostgreSQL-owned). Never a prod URL.
API_BASE_URL=https://staging.example.invalid

# Bump for every APK you hand out: version 4.0.0-gotest.<GOTEST_BUILD>, Android versionCode <GOTEST_BUILD>.
GOTEST_BUILD=1

# Local Go stack (pnpm build:mobile:gotest:local): the phone reaches it through `adb reverse`, so this is a loopback
# URL on the phone and on this machine alike. Default http://127.0.0.1:18081 (forwarder container in front of api:8081).
# LOCAL_API_BASE_URL=http://127.0.0.1:18081
