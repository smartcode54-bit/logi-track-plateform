# Service account keys — never commit
**/service-account*.json

# Env files with secrets (keep *.example committed; never commit real values)
envs/.env.prod.web
envs/.env.prod.mobile
envs/.env.dev.web
envs/.env.dev.mobile

# Firebase Functions env (API keys; use functions/.env.example as template)
logitrack-web/functions/.env
logitrack-web/functions/.env.*
!logitrack-web/functions/.env.example

# Markdown and docs
README.md
*.md
**/doc/
**/docs/
node_modules
node_modules

# Flutter/Android build outputs (do not commit)
logitrack-mobile/build/
logitrack-mobile/android/app/build/
logitrack-mobile/android/build/
logitrack-mobile/.dart_tool/
logitrack-mobile/android/.gradle/
logitrack-mobile/android/.cxx/

# Local sample import files
file example/

# MCP server config (contains API keys)
.mcp.json

# Claude Code worktrees (local only, not for version control)
.claude/worktrees/
logitrack-mobile/.claude/worktrees/
