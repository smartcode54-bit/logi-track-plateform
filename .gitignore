# Service account keys — never commit
**/service-account*.json

# Env files with secrets (keep *.example committed; never commit real values)
envs/.env.prod.web
envs/.env.prod.mobile
envs/.env.dev.web
envs/.env.dev.mobile
envs/.env.gotest.mobile

# Firebase Functions env (API keys; use functions/.env.example as template)
logitrack-web/functions/.env
logitrack-web/functions/.env.*
!logitrack-web/functions/.env.example

# Markdown and docs (ignored by default; track key docs with `git add -f`)
README.md
*.md
**/doc/
**/docs/
node_modules
node_modules

# Flutter/Android build outputs (do not commit)
logitrack-mobile/build/
logitrack-mobile/android/app/build/
logitrack-mobile/android/build/
logitrack-mobile/.dart_tool/
logitrack-mobile/android/.gradle/
logitrack-mobile/android/.cxx/

# Local sample import files
file example/

# MCP server config (contains API keys)
.mcp.json

# Claude Code worktrees (local only, not for version control)
.claude/worktrees/
logitrack-mobile/.claude/worktrees/

# JVM crash dumps (Gradle/Android toolchain) — never useful in version control
hs_err_pid*.log
replay_pid*.log

# Local scratch dumps from grep/refactor sessions
grep_*.txt
files_to_refactor.txt
**/tmp_*.mjs

# logitrack-firmware (PlatformIO; source lives on branch pio-initial): build cache + generated IDE files
logitrack-firmware/.pio/
logitrack-firmware/.vscode/.browse.c_cpp.db*
logitrack-firmware/.vscode/c_cpp_properties.json
logitrack-firmware/.vscode/launch.json
logitrack-firmware/.vscode/ipch

# Mobile credentials: never in git (the repo is public). Real values live in envs/ (gitignored) and are copied in
# by the build scripts; google-services.json per flavor comes from the Firebase console.
logitrack-mobile/.env
logitrack-mobile/.env.dev
logitrack-mobile/.env.prod
logitrack-mobile/android/app/src/*/google-services.json
logitrack-mobile/ios/**/GoogleService-Info.plist
logitrack-mobile/.env.prod.gotest-build-backup
