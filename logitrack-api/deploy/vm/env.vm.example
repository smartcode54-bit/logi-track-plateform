# Template of /opt/logitrack/shared/.env on the staging VM showkhun.co (deploy/vm/README.md, developer-spec.md
# §17.4, §19 Q8). Names come from §16.1 only; `make env-check` holds this file to the names api, worker,
# scheduler, migrate, seed and the web server read (env-names/*.txt), plus the RabbitMQ container's two.
#
# Names only for secrets: every secret name is blank here. provision.sh (tools/vmenv, as root on the VM)
# generates the values on the server and never prints or copies them; on a re-run every existing value
# of the .env is kept, and a name added here later is appended with this file's value. Edit the VM's .env
# (as root, it is 0640 root:logitrack) and `pm2 reload <app>` to change a setting there.
#
# Listener addresses differ per pm2 app, so ecosystem.config.cjs sets them and they are never keys here:
# per-process (ecosystem.config.cjs): API_INTERNAL_ADDR API_PUBLIC_ADDR METRICS_ADDR GO_API_INTERNAL_URL PORT HOSTNAME NODE_ENV

# --- Process, logging, ingress (the api listens on loopback only; nginx fronts the public listener) ---
APP_ENV=dev
LOG_LEVEL=info
LOG_FORMAT=json
SHUTDOWN_TIMEOUT=30s
PPROF_ENABLED=false
PUBLIC_ROUTE_GROUPS=/v1/mobile,/v1/auth,/public/v1,/evidence,/healthz,/media
# nginx and the web server both reach the api from 127.0.0.1; nginx sets X-Forwarded-For to the Cloudflare
# client address (real_ip), and the BFF passes it on.
TRUSTED_PROXY_CIDRS=127.0.0.1/32
PUBLIC_API_BASE_URL=https://logi-api.showkhun.co
PUBLIC_WEB_BASE_URL=https://logi.showkhun.co
# The P0 state of the web domain flags: only auth is served by Go, every other domain stays on the dev
# Firebase project (bridge `web` mode once firebase-sa.json is placed). See README "Web domain flags".
PG_OWNED_DOMAINS=
WEB_FLAG_OVERRIDES=auth=go

# --- PostgreSQL 18: the server's cluster on 127.0.0.1:5432, database logitrack (R66, R87) ---
DATABASE_URL=
MIGRATE_DATABASE_URL=
ETL_DATABASE_URL=
# 3 vCPU: about 2 x CPU per process
DATABASE_MAX_CONNS=6
DATABASE_MIN_CONNS=1
DATABASE_MIGRATE_ON_START=false

# --- Redis: container logitrack-redis on 127.0.0.1:6381 (the password lives inside REDIS_URL) ---
REDIS_URL=
REDIS_KEY_PREFIX=lt:dev:
REDIS_TLS=false

# --- Cache, idempotency, rate limits ---
CACHE_TTL_HUBS=10m
CACHE_TTL_RATECARD=1h
CACHE_TTL_SETTINGS=5m
IDEMPOTENCY_TTL=168h
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/1m
RATE_LIMIT_PUBLIC_FORMS=5/1h
RATE_LIMIT_EVIDENCE=60/1m

# --- RabbitMQ: container logitrack-rabbitmq on 127.0.0.1:5674 (management 127.0.0.1:15674) ---
RABBITMQ_URL=
RABBITMQ_PREFETCH=
WORKER_CONSUMERS=all
OUTBOX_RELAY_INTERVAL=200ms
OUTBOX_BATCH_SIZE=500
RABBITMQ_DEFAULT_USER=logitrack
RABBITMQ_DEFAULT_PASS=

# --- Object storage: local disk until S3-compatible settings arrive (§9.11) ---
# Every S3_* connection name stays empty: the local backend needs none of them, and an empty S3_BUCKET /
# S3_PUBLIC_BUCKET means the defaults logitrack / logitrack-public, which label the local rows. The two
# S3_PRESIGN_*_TTL also time the local backend's signed URLs.
# Switching to s3 later: fill S3_* and set STORAGE_BACKEND=s3, keeping LOCAL_MEDIA_* while local rows exist.
STORAGE_BACKEND=local
LOCAL_MEDIA_DIR=/opt/logitrack/shared/media
LOCAL_MEDIA_PUBLIC_BASE_URL=https://logi.showkhun.co/media
LOCAL_MEDIA_SIGNING_KEY=
S3_ENDPOINT=
S3_PRESIGN_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_BUCKET=
S3_USE_PATH_STYLE=
S3_USE_SSL=
S3_PUBLIC_BASE_URL=
CORS_ALLOWED_ORIGINS=
S3_PRESIGN_GET_TTL=1h
S3_PRESIGN_PUT_TTL=15m
# nginx client_max_body_size on both vhosts is 10m (= this value); raise both together.
UPLOAD_MAX_BYTES=10485760
IMAGES_THUMBNAIL_ENABLED=false
# Sarabun for documents.render (P3); unused until then.
PDF_FONT_DIR=

# --- Auth ---
JWT_SIGNING_KEY_FILE=/opt/logitrack/shared/secrets/jwt-ed25519.pem
JWT_PREVIOUS_KEY_FILE=
# Set by provision.sh: the RFC 7638 thumbprint of JWT_SIGNING_KEY_FILE (not a secret).
JWT_ACTIVE_KID=
JWT_ISSUER=https://logi-api.showkhun.co
JWT_AUDIENCE=logitrack-dev
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_WEB=168h
REFRESH_TOKEN_TTL_MOBILE=2160h
PASSWORD_RESET_TTL=30m
PASSWORD_MIN_LENGTH=10
ARGON2_MEMORY_KB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2
# Google sign-in stays off until the owner adds the GIS client ids (and logi.showkhun.co as an authorized
# JavaScript origin of that client).
GOOGLE_OIDC_ALLOWED_CLIENT_IDS=
# The bootstrap super admin (owner decision 2026-10-10); login is by email.
PLATFORM_ADMIN_EMAILS=ssadmin@showkhun.co
# The Firebase Console "Password hash parameters" stay with the owner: no legacy hash is verified here.
FIREBASE_SCRYPT_SIGNER_KEY=
FIREBASE_SCRYPT_SALT_SEPARATOR=
FIREBASE_SCRYPT_ROUNDS=
FIREBASE_SCRYPT_MEM_COST=
# The dev Firebase project (logitrack-web/.firebaserc "default") for the web and the bridge.
FIREBASE_PROJECT_ID=logi-track-wrt-dev
# off until shared/secrets/firebase-sa.json is placed; then web (README "Firebase and FCM").
AUTH_FIREBASE_BRIDGE_MODE=off
API_KEY_PEPPER=
MOBILE_ATTESTATION_MODE=off
MOBILE_VERSION_FLOOR_ENFORCE=false
EVIDENCE_TOKEN_TTL_DAYS=0
MOBILE_SSE_ENABLED=false

# --- Tenancy, ETL, coexistence (staging runs on cmd/seed data, §19 Q7) ---
# Set by provision.sh: a uuid v7 for this environment (not a secret); the demo seed builds the own fleet on it.
OWN_FLEET_TENANT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/opt/logitrack/shared/secrets/firebase-sa.json
ETL_FIRESTORE_PROJECT_ID=logi-track-wrt-dev
FIRESTORE_DATABASE_ID=(default)
ETL_SYNC_ENABLED=false
ETL_SYNC_INTERVAL=5m
ETL_MIRROR_COLLECTIONS=
COMPAT_PROJECTION_ENABLED=false
COMPAT_PROJECTION_COLLECTIONS=

# --- Integrations (off on staging) ---
FCM_PROJECT_ID=logi-track-wrt-dev
FCM_SERVICE_ACCOUNT_JSON=/opt/logitrack/shared/secrets/fcm-sa.json
# false until shared/secrets/fcm-sa.json is placed (README "Firebase and FCM").
FCM_ENABLED=false
LINE_CHANNEL_ACCESS_TOKEN=
LINE_NOTIFY_ENABLED=false
LINE_API_BASE_URL=
LINE_CHANNEL_SECRET=
CARTRACK_API_USERNAME=
CARTRACK_API_PASSWORD=
CARTRACK_API_BASE_URL=
CARTRACK_SYNC_ENABLED=false
FUEL_MONTHLY_SNAPSHOT_ENABLED=false
BANGCHAK_API_BASE_URL=
GOOGLE_MAPS_SERVER_API_KEY=
DISTANCE_MATRIX_ENABLED=false
GOOGLE_MAPS_STATIC_KEY=
GOOGLE_CLOUD_VISION_API_KEY=
OCR_PROXY_ENABLED=false
EVIDENCE_BASE_URL=https://logi-api.showkhun.co/evidence
EVIDENCE_PRESIGN_TTL=15m

# --- Email: no SMTP relay on staging (reset and invite mails are not sent) ---
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=LogiTrack
SMTP_STARTTLS=true
NOTIFY_ADMIN_ON_DRIVER_MESSAGE=false
TURNSTILE_SECRET_KEY=

# --- Realtime ---
SSE_PING_INTERVAL=25s
SSE_MAX_CONN_PER_USER=5
RTLOG_MAXLEN=10000
RTLOG_TTL=24h

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=
OTEL_TRACES_SAMPLER_ARG=1
SENTRY_DSN=

# --- Seed: the multi-tenant demo profile on the first deploy, then the bootstrap super admin ---
SEED_PROFILE=demo
SEED_RANDOM_SEED=20261009
SEED_ANCHOR_DATE=
SEED_NAMESPACE=
# The password of every seeded demo user (generated; read it as root from the .env, never printed).
SEED_DEFAULT_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=ssadmin@showkhun.co
# Generated; only in this .env: `grep BOOTSTRAP_ADMIN_PASSWORD /opt/logitrack/shared/.env` as root.
BOOTSTRAP_ADMIN_PASSWORD=

# --- Web server (Next.js standalone + BFF; §16.1 web-server). JWT_ISSUER / JWT_AUDIENCE / JWT_ACCESS_TTL /
# REFRESH_TOKEN_TTL_WEB above are shared with the api (R39). GO_API_INTERNAL_URL, PORT, HOSTNAME and
# NODE_ENV are per-process (ecosystem.config.cjs). ---
GO_API_INTERNAL_TIMEOUT_MS=30000
# Host-only cookies on logi.showkhun.co.
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=true
WEB_PUBLIC_ORIGIN=https://logi.showkhun.co
