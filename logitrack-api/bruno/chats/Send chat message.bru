meta {
  name: Send chat message
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/v1/chats/:id/messages
  body: json
  auth: inherit
}

params:path {
  id: 00000000-0000-0000-0000-000000000000
}

body:json {
  {
    "text": "Hello",
    "imageKey": null,
    "clientMessageId": "client-msg-0001"
  }
}

assert {
  res.status: eq 200
  res.body.data: isDefined
}

docs {
  `POST /v1/chats/:id/messages`

  Sends a text and/or image message. clientMessageId makes the send idempotent; 409 idempotency_conflict if reused for a different message.

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `chat:send`
  - **Listeners:** internal
  - **Success:** `200`; `data` has `id`, `chatId`, `senderRole`, `senderName`, `text`, `imageUrl`
}
