meta {
  name: Assign chat
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/chats/:id/assign
  body: json
  auth: inherit
}

params:path {
  id: 00000000-0000-0000-0000-000000000000
}

body:json {
  {
    "adminUserId": "00000000-0000-0000-0000-000000000000"
  }
}

assert {
  res.status: eq 200
  res.body.data: isDefined
}

docs {
  `POST /v1/chats/:id/assign`

  Assigns the chat: adminUserId absent = self, null = back to queue.

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `chat:send`
  - **Listeners:** internal
  - **Success:** `200`; `data` has `id`, `tenantId`, `driverId`, `driverName`, `status`, `priority`, `assignedAdminUserId`
}
