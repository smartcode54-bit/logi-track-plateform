meta {
  name: List chat messages
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/v1/chats/:id/messages
  body: none
  auth: inherit
}

params:query {
  ~before: 
  ~limit: 50
}

params:path {
  id: 00000000-0000-0000-0000-000000000000
}

assert {
  res.status: eq 200
  res.body.data: isDefined
}

docs {
  `GET /v1/chats/:id/messages`

  Messages, newest first (keyset).

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `chat:view`
  - **Listeners:** internal
  - **Success:** `200`; `data` is a list of objects with `id`, `chatId`, `senderRole`, `senderName`, `text`, `imageUrl`; `nextCursor` pages
  - **Query `before`**: cursor: return messages before this
  - **Query `limit`**: page size
}
