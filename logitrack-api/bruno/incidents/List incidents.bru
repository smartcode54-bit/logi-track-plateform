meta {
  name: List incidents
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/incidents
  body: none
  auth: inherit
}

params:query {
  ~from: 2026-11-01
  ~to: 2026-11-30
  ~tripId: 00000000-0000-0000-0000-000000000000
  ~driverId: 00000000-0000-0000-0000-000000000000
  ~limit: 50
  ~cursor: 
}

assert {
  res.status: eq 200
  res.body.data: isDefined
}

docs {
  `GET /v1/incidents`

  Lists incident reports newest first (keyset pages).

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `operations:view_incidents`, `dispatch:view_operations`
  - **Listeners:** internal
  - **Success:** `200`; `data` is a list of objects with `id`, `tripNo`, `driverName`, `delayCause`, `description`, `createdAt`; `nextCursor` pages
  - **Query `from`**: range start
  - **Query `to`**: range end
  - **Query `tripId`**: trip id
  - **Query `driverId`**: driver id
  - **Query `limit`**: page size
  - **Query `cursor`**: opaque keyset cursor from nextCursor
}
