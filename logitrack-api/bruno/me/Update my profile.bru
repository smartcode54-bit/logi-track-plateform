meta {
  name: Update my profile
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/v1/me
  body: json
  auth: inherit
}

body:json {
  {
    "displayName": "Somchai Jaidee",
    "photoKey": "users/00000000-0000-0000-0000-000000000000/photo.jpg",
    "lastLoginGeo": {
      "lat": 13.75,
      "lng": 100.5,
      "source": "gps",
      "accuracyM": 25
    }
  }
}

assert {
  res.status: eq 200
  res.body.data: isDefined
}

docs {
  `PATCH /v1/me`

  Updates displayName, profile photo (photoKey from a user_photo presign) and last login geo. Returns the full profile.

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Listeners:** internal
  - **Success:** `200`; `data` has `id`, `email`, `displayName`, `tenant`, `capabilities`, `mustChangePassword`
}
