meta {
  name: App installation stats
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/app-installations/stats
  body: none
  auth: inherit
}

params:query {
  ~tenantId: 00000000-0000-0000-0000-000000000000
  ~since: 7d
  ~belowVersion: 3.6.0
}

assert {
  res.status: eq 200
  res.body.data: isDefined
}

docs {
  `GET /v1/app-installations/stats`

  Aggregate counts of installations by status, flavor and platform.

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `security:view_mobile_clients`
  - **Listeners:** internal
  - **Success:** `200`; `data` has `since`, `total`, `byStatus`, `byFlavor`, `byPlatform`, `belowVersion`
  - **Query `tenantId`**: filter by tenant
  - **Query `since`**: RFC3339 time or window like 7d / 24h
  - **Query `belowVersion`**: count installs below this version
}
