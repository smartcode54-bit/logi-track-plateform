}

assert {
  res.status: eq 201
  res.body.data: isDefined
}

docs {
  `POST /v1/maintenance`

  Creates a maintenance record (PM or CM) for a truck.

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `fleet:manage_maintenance`
  - **Listeners:** internal
  - **Success:** `201`; `data` has `id`, `tenantId`, `truckId`, `licensePlate`, `type`, `status`, `displayCostThb`
}
