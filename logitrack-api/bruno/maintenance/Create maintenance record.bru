meta {
  name: Create maintenance record
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/maintenance
  body: json
  auth: inherit
}

body:json {
  {
    "truckId": "00000000-0000-0000-0000-000000000000",
    "type": "PM",
    "serviceType": "เช็คระยะตามรอบ",
    "startDate": "2026-11-25",
    "endDate": "2026-11-26",
    "status": "scheduled",
    "appointmentTime": "09:00",
    "pickupAppointmentAt": "2026-11-26T10:00:00Z",
    "costLaborThb": 1500,
    "costPartsThb": 3500,
