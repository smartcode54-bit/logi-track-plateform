meta {
  name: List standby records
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/standby
  body: none
  auth: inherit
}

params:query {
  ~sort: createdAt
  ~from: 2026-11-01
  ~to: 2026-11-30
  ~driverId: 00000000-0000-0000-0000-000000000000
  ~customerId: 00000000-0000-0000-0000-000000000000
  ~limit: 50
  ~cursor: 
}

assert {
  res.status: eq 200
  res.body.data: isDefined
}

docs {
  `GET /v1/standby`

  Lists standby records with duration, photos and billing summary (keyset pages).

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `operations:view_driver_monitor`, `dispatch:view_operations`
  - **Listeners:** internal
  - **Success:** `200`; `data` is a list of objects with `id`, `driverName`, `startLocation`, `endLocation`, `durationMinutes`, `status`; `nextCursor` pages
  - **Query `sort`**: sort order
  - **Query `from`**: range start
  - **Query `to`**: range end
  - **Query `driverId`**: driver id
  - **Query `customerId`**: customer id
  - **Query `limit`**: page size
  - **Query `cursor`**: opaque keyset cursor from nextCursor
}
