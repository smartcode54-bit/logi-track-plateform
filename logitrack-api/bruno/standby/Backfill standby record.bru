assert {
  res.status: eq 201
  res.body.data: isDefined
}

docs {
  `POST /v1/standby/backfill`

  Creates a completed standby record for a past job; also completes its task and sets the trip to standby. endedAt must be after startedAt.

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `operations:create_standby`
  - **Listeners:** internal
  - **Success:** `201`; `data` has `id`, `driverName`, `startedAt`, `endedAt`, `status`
}
