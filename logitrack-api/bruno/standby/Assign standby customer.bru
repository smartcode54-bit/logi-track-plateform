meta {
  name: Assign standby customer
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/v1/standby/:id/customer
  body: json
  auth: inherit
}

params:path {
  id: 00000000-0000-0000-0000-000000000000
}

body:json {
  {
    "customerId": "00000000-0000-0000-0000-000000000000"
  }
}

assert {
  res.status: eq 200
  res.body.data: isDefined
}

docs {
  `PATCH /v1/standby/:id/customer`

  Assigns the billing customer of a standby record and prices it; a priced record also needs accounting:recompute_force. Own-fleet only.

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `accounting:edit_rate_card`
  - **Listeners:** internal
  - **Success:** `200`; `data` has `id`, `billingEstimateThb`, `customerPartyId`
}
