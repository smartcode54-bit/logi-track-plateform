meta {
  name: List drivers
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/drivers
  body: none
  auth: inherit
}

params:query {
  ~status: active
  ~q: somchai
  ~fields: minimal
  ~tenantId: 00000000-0000-0000-0000-000000000000
  ~limit: 50
  ~cursor: 
}

assert {
  res.status: eq 200
  res.body.data: isDefined
}

docs {
  `GET /v1/drivers`

  Lists drivers in the caller's reach (keyset paged). fields=minimal returns a reduced projection; API keys are refused.

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `drivers:view`, `dispatch:view_operations`
  - **Listeners:** internal
  - **Success:** `200`; `data` is a list of objects with `id`, `tenantId`, `displayName`, `firstName`, `lastName`, `status`; `nextCursor` pages
  - **Query `status`**: active | inactive | on_duty
  - **Query `q`**: search text
  - **Query `fields`**: minimal for reduced projection
  - **Query `tenantId`**: tenant filter
  - **Query `limit`**: page size
  - **Query `cursor`**: opaque keyset cursor from previous nextCursor
}
