meta {
  name: Get driver
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/drivers/:id
  body: none
  auth: inherit
}

params:path {
  id: 00000000-0000-0000-0000-000000000000
}

assert {
  res.status: eq 200
  res.body.data: isDefined
}

docs {
  `GET /v1/drivers/:id`

  Returns one driver; PII fields only with drivers:view_pii.

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `drivers:view`
  - **Listeners:** internal
  - **Success:** `200`; `data` has `id`, `tenantId`, `displayName`, `firstName`, `lastName`, `status`
}
