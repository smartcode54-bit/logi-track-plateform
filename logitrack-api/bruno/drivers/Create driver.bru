assert {
  res.status: eq 201
  res.body.data: isDefined
}

docs {
  `POST /v1/drivers`

  Creates a driver. PII is returned only to callers with drivers:view_pii (response then Cache-Control: no-store).

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `drivers:create`
  - **Listeners:** internal
  - **Success:** `201`; `data` has `id`, `tenantId`, `displayName`, `firstName`, `lastName`, `status`
}
