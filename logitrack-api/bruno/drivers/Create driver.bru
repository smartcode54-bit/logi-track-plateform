meta {
  name: Create driver
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/drivers
  body: json
  auth: inherit
}

body:json {
  {
    "tenantId": "00000000-0000-0000-0000-000000000000",
    "firstName": "Somchai",
