    "fullNameTh": "สมชาย ใจดี",
    "mobile": "0812345678",
    "email": "driver@example.com",
    "birthDate": "1990-01-31",
    "idCard": "1234567890123",
    "idCardExpiredDate": "2030-01-31",
    "truckLicenseId": "12345678",
    "licenseType": "บ.2",
