meta {
  name: Get task trip
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/v1/tasks/:id/trip
  body: none
  auth: inherit
}

params:path {
  id: 00000000-0000-0000-0000-000000000000
}

assert {
  res.status: eq 200
  res.body.data: isDefined
}

docs {
  `GET /v1/tasks/:id/trip`

  Returns the trip record of a task, 404 when none exists yet.

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `operations:view_first_mile`, `operations:view_line_haul`
  - **Listeners:** internal
  - **Success:** `200`; `data` has `id`, `tripNo`, `status`, `jobType`, `driverName`, `deliveredAt`
}
