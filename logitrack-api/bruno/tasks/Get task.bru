meta {
  name: Get task
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/tasks/:id
  body: none
  auth: inherit
}

params:path {
  id: 00000000-0000-0000-0000-000000000000
}

assert {
  res.status: eq 200
  res.body.data: isDefined
}

docs {
  `GET /v1/tasks/:id`

  Returns one task. Staff need a view capability; a driver may read its own or helper tasks (another driver's task is 404).

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `operations:view_first_mile`, `operations:view_line_haul`
  - **Listeners:** internal
  - **Success:** `200`; `data` has `id`, `taskNo`, `taskType`, `status`, `sourceHub`, `destination`
}
