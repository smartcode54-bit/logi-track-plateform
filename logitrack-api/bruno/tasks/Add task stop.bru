meta {
  name: Add task stop
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/tasks/:id/stops
  body: json
  auth: inherit
}

params:path {
  id: 00000000-0000-0000-0000-000000000000
}

body:json {
  {
    "destination": "Lotus Bangna",
    "destinationHubId": "00000000-0000-0000-0000-000000000000",
    "destinationLinkedPartyId": "00000000-0000-0000-0000-000000000000",
    "sourceId": "HUB001",
    "isCustom": false
  }
}

assert {
  res.status: eq 201
  res.body.data: isDefined
}

docs {
  `POST /v1/tasks/:id/stops`

  Adds a delivery stop to a task, upgrading it to multi-delivery. 409 no_primary_destination when the task lacks a destination.

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `operations:manage_tasks`
  - **Listeners:** internal
  - **Success:** `201`; `data` has `taskId`, `upgradedFromSingle`, `stops`
}
