meta {
  name: Submit partner interest
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/partner-interest
  body: json
  auth: none
}

body:json {
  {
    "companyName": "Example Transport",
    "contractNumber": "",
    "contactName": "Somchai",
    "email": "partner@example.com",
    "serviceArea": "Bangkok",
    "fleetSize": "10",
    "vehicleType": "4W",
    "website": ""
  }
}

assert {
  res.status: eq 201
  res.body.data: isDefined
}

docs {
  `POST /v1/partner-interest`

  Anonymous public form post (via the BFF), rate-limited. The website field is a honeypot and must stay empty.

  - **Auth:** None (anonymous)
  - **Listeners:** internal
  - **Success:** `201`; `data` has `id`
}
