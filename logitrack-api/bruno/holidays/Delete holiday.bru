meta {
  name: Delete holiday
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/v1/holidays/:id
  body: none
  auth: inherit
}

params:path {
  id: 00000000-0000-0000-0000-000000000000
}

assert {
  res.status: eq 204
}

docs {
  `DELETE /v1/holidays/:id`

  Deletes a holiday.

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `hr:manage_holidays`
  - **Listeners:** internal
  - **Success:** `204`
}
