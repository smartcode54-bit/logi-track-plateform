vars {
  baseUrl: https://logi.showkhun.co/api/go
  publicBaseUrl: https://logi-api.showkhun.co
  viaBff: true
  loginPlatform: web
  email: {{process.env.LOGITRACK_EMAIL}}
  password: {{process.env.LOGITRACK_PASSWORD}}
  apiKey: {{process.env.LOGITRACK_API_KEY}}
  shimApiKey: {{process.env.LOGITRACK_SHIM_API_KEY}}
  firebaseIdToken: {{process.env.LOGITRACK_FIREBASE_ID_TOKEN}}
  googleIdToken: {{process.env.LOGITRACK_GOOGLE_ID_TOKEN}}
}
