meta {
  name: Get trip
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/trips/:id
  body: none
  auth: inherit
}

params:path {
  id: 00000000-0000-0000-0000-000000000000
}

assert {
  res.status: eq 200
  res.body.data: isDefined
}

docs {
  `GET /v1/trips/:id`

  Returns one trip record with detail.

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `operations:view_driver_monitor`, `accounting:view_income`
  - **Listeners:** internal
  - **Success:** `200`; `data` has `id`, `tripNo`, `status`, `jobType`, `driverName`, `deliveredAt`
}
