meta {
  name: Compute trip billing
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/trips/:id/billing/compute
  body: json
  auth: inherit
}

params:path {
  id: 00000000-0000-0000-0000-000000000000
}

body:json {
  {
    "forceRecompute": false
  }
}

assert {
  res.status: eq 200
  res.body.data: isDefined
}

docs {
  `POST /v1/trips/:id/billing/compute`

  Prices an unpriced delivered trip; forceRecompute needs accounting:recompute_force on the own fleet. 409 billing_period_locked (details.blockedInvoiceNumber) when the period is sent or paid. Amounts only shown to the own fleet.

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Listeners:** internal
  - **Success:** `200`; `data` has `ok`, `skipped`, `billingEstimateThb`, `error`, `reason`, `billingDateMoved`
}
