meta {
  name: Set trip job category
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/v1/trips/:id/job-category
  body: json
  auth: inherit
}

params:path {
  id: 00000000-0000-0000-0000-000000000000
}

body:json {
  {
    "jobCategory": "PRIMARY"
  }
}

assert {
  res.status: eq 200
  res.body.data: isDefined
}

docs {
  `POST /v1/trips/:id/job-category`

  Changes the primary/secondary job category of a trip and reprices it atomically. Own-fleet only.

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `accounting:edit_rate_card`
  - **Listeners:** internal
  - **Success:** `200`; `data` has `id`, `billingEstimateThb`, `jobCategory`
}
