meta {
  name: Rename trip number
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/v1/trips/:id/rename
  body: json
  auth: inherit
}

params:path {
  id: 00000000-0000-0000-0000-000000000000
}

body:json {
  {
    "newTripNo": "TRP-20261122-999"
  }
}

assert {
  res.status: eq 200
  res.body.data: isDefined
}

docs {
  `POST /v1/trips/:id/rename`

  Changes the trip number (tenant admin only, even after delivery). 409 when the new number is taken.

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `operations:edit_trip_details`
  - **Listeners:** internal
  - **Success:** `200`; `data` has `id`, `tripNo`, `status`, `jobType`, `driverName`, `deliveredAt`
}
