meta {
  name: Submit payroll run job
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/v1/jobs/payroll.run
  body: json
  auth: inherit
}

body:json {
  {
    "period": "2026-11",
    "round": "1"
  }
}

assert {
  res.status: eq 202
  res.body.data: isDefined
}

docs {
  `POST /v1/jobs/payroll.run`

  Queues a payroll generation for a period and round (202 {jobId}).

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `hr:manage_payroll`
  - **Listeners:** internal
  - **Success:** `202`; `data` has `jobId`
}
