meta {
  name: Create API key
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/api-keys
  body: json
  auth: inherit
}

headers {
  ~X-Act-On-Tenant: 00000000-0000-0000-0000-000000000000
}

body:json {
  {
    "name": "Reporting integration",
    "scope": "integration",
    "capabilities": [
      "trips:view"
    ],
    "expiresAt": "2027-12-31T00:00:00Z",
    "tenantId": "00000000-0000-0000-0000-000000000000"
  }
}

assert {
  res.status: eq 201
  res.body.data: isDefined
}

docs {
  `POST /v1/api-keys`

  Creates an API key; the secret is returned once. Omit tenantId for a platform key (platform_admin only).

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `security:manage_api_keys`
  - **Listeners:** internal
  - **Success:** `201`; `data` has `id`, `name`, `scope`, `keyPrefix`, `secret`, `expiresAt`
  - **Header `X-Act-On-Tenant`**: Platform staff only: act on this tenant (uuid) or * for all tenants (read-only).
}
