meta {
  name: Remove tenant member
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/v1/tenants/:id/members/:userId
  body: none
  auth: inherit
}

params:path {
  id: 00000000-0000-0000-0000-000000000000
  userId: 00000000-0000-0000-0000-000000000000
}

headers {
  ~X-Act-On-Tenant: 00000000-0000-0000-0000-000000000000
}

assert {
  res.status: eq 204
}

docs {
  `DELETE /v1/tenants/:id/members/:userId`

  Removes the membership. 409 driver_linked if the user is an active linked driver.

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `users:assign_role`
  - **Listeners:** internal
  - **Success:** `204`
  - **Header `X-Act-On-Tenant`**: Platform staff only: act on this tenant (uuid) or * for all tenants (read-only).
}
