meta {
  name: Get tenant
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/tenants/:id
  body: none
  auth: inherit
}

params:path {
  id: 00000000-0000-0000-0000-000000000000
}

headers {
  ~X-Act-On-Tenant: 00000000-0000-0000-0000-000000000000
}

assert {
  res.status: eq 200
  res.body.data: isDefined
}

docs {
  `GET /v1/tenants/:id`

  Returns one tenant; visibility is by RLS and reach. Support principals get 403.

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Listeners:** internal
  - **Success:** `200`; `data` has `id`, `kind`, `code`, `nameTh`, `nameEn`, `status`
  - **Header `X-Act-On-Tenant`**: Platform staff only: act on this tenant (uuid) or * for all tenants (read-only).
}
