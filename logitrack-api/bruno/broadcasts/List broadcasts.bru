meta {
  name: List broadcasts
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/broadcasts
  body: none
  auth: inherit
}

params:query {
  ~limit: 50
  ~cursor: 
}

assert {
  res.status: eq 200
  res.body.data: isDefined
}

docs {
  `GET /v1/broadcasts`

  Sent broadcasts with read counts, newest first.

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `broadcasts:view`
  - **Listeners:** internal
  - **Success:** `200`; `data` is a list of objects with `id`, `createdByName`, `title`, `messageText`, `recipientGroup`, `recipientCount`, `readCount`, `sentAt`; `nextCursor` pages
  - **Query `limit`**: page size
  - **Query `cursor`**: opaque cursor from a previous page's nextCursor
}
