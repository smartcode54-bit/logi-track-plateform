meta {
  name: Invite user
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/v1/users/:id/invite
  body: json
  auth: inherit
}

params:path {
  id: 00000000-0000-0000-0000-000000000000
}

headers {
  ~X-Act-On-Tenant: 00000000-0000-0000-0000-000000000000
}

body:json {
  {
    "locale": "th"
  }
}

assert {
  res.status: eq 202
  res.body.data: isDefined
}

docs {
  `POST /v1/users/:id/invite`

  Queues an invitation email (password reset link) for the user. Responds 202.

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `users:manage`
  - **Listeners:** internal
  - **Success:** `202`; `data` has `queued`
  - **Header `X-Act-On-Tenant`**: Platform staff only: act on this tenant (uuid) or * for all tenants (read-only).
}
