meta {
  name: Revoke one user session
  type: http
  seq: 18
}

delete {
  url: {{baseUrl}}/v1/users/:id/sessions/:sid
  body: none
  auth: inherit
}

params:path {
  id: 00000000-0000-0000-0000-000000000000
  sid: 00000000-0000-0000-0000-000000000000
}

headers {
  ~X-Act-On-Tenant: 00000000-0000-0000-0000-000000000000
}

assert {
  res.status: eq 204
}

docs {
  `DELETE /v1/users/:id/sessions/:sid`

  Revokes one session; both ids must be uuids else 404.

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `users:revoke_sessions`
  - **Listeners:** internal
  - **Success:** `204`
  - **Header `X-Act-On-Tenant`**: Platform staff only: act on this tenant (uuid) or * for all tenants (read-only).
}
