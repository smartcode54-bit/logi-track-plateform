meta {
  name: Link user to driver
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/v1/users/:id/driver-link
  body: json
  auth: inherit
}

params:path {
  id: 00000000-0000-0000-0000-000000000000
}

headers {
  ~X-Act-On-Tenant: 00000000-0000-0000-0000-000000000000
}

body:json {
  {
    "driverId": "00000000-0000-0000-0000-000000000000"
  }
}

assert {
  res.status: eq 204
}

docs {
  `PUT /v1/users/:id/driver-link`

  Links the user account to a driver profile (drivers.user_id is unique).

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `drivers:edit`, `users:manage`
  - **Listeners:** internal
  - **Success:** `204`
  - **Header `X-Act-On-Tenant`**: Platform staff only: act on this tenant (uuid) or * for all tenants (read-only).
}
