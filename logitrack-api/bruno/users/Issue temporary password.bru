meta {
  name: Issue temporary password
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/v1/users/:id/password/temporary
  body: none
  auth: inherit
}

params:path {
  id: 00000000-0000-0000-0000-000000000000
}

headers {
  ~X-Act-On-Tenant: 00000000-0000-0000-0000-000000000000
}

assert {
  res.status: eq 200
  res.body.data: isDefined
}

docs {
  `POST /v1/users/:id/password/temporary`

  Generates a temporary password, shown once in the response (Cache-Control: no-store).

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `users:manage`
  - **Listeners:** internal
  - **Success:** `200`; `data` has `temporaryPassword`
  - **Header `X-Act-On-Tenant`**: Platform staff only: act on this tenant (uuid) or * for all tenants (read-only).
}
