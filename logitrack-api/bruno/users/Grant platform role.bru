meta {
  name: Grant platform role
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/v1/users/:id/platform-roles
  body: json
  auth: inherit
}

params:path {
  id: 00000000-0000-0000-0000-000000000000
}

body:json {
  {
    "role": "support"
  }
}

assert {
  res.status: eq 204
}

docs {
  `POST /v1/users/:id/platform-roles`

  Grants a platform role (e.g. support, platform_admin) to the user.

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `platform:manage_platform_roles`
  - **Listeners:** internal
  - **Success:** `204`
}
