meta {
  name: Platform security overview
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/v1/platform/security/overview
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.data: isDefined
}

docs {
  `GET /v1/platform/security/overview`

  Platform-staff read; the principal must hold the stated capability on the platform plane. Responses are projected (consent-aware).

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `security:view_overview`
  - **Listeners:** internal
  - **Success:** `200`; `data` has `generatedAt`, `scope`, `users`, `sessions`, `logins`, `events`
}
