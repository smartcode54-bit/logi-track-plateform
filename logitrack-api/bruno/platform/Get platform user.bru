meta {
  name: Get platform user
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/v1/platform/users/:id
  body: none
  auth: inherit
}

params:path {
  id: 00000000-0000-0000-0000-000000000000
}

assert {
  res.status: eq 200
  res.body.data: isDefined
}

docs {
  `GET /v1/platform/users/:id`

  Platform-staff read; the principal must hold the stated capability on the platform plane. Responses are projected (consent-aware).

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `users:view`
  - **Listeners:** internal
  - **Success:** `200`; `data` has `id`, `email`, `displayName`, `status`, `memberships`, `platformRoles`
}
