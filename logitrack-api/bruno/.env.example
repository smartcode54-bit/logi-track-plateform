# Copy to .env (git-ignored) in this folder. Bruno reads it as {{process.env.NAME}}.
# Names only here: never commit a value.
LOGITRACK_EMAIL=wrt.admin@logitrack.test
LOGITRACK_PASSWORD=
# X-Api-Key of an integration, script or release_publisher key (GET /v1/roles, POST /v1/app-releases*).
LOGITRACK_API_KEY=
# Shim routes (/v1/mobile/me, .../stops, .../billing/compute, .../line-notify, broadcast read).
LOGITRACK_SHIM_API_KEY=
LOGITRACK_FIREBASE_ID_TOKEN=
# POST /v1/auth/google: a Google ID token minted for the nonce of GET /v1/auth/google/nonce.
LOGITRACK_GOOGLE_ID_TOKEN=
