meta {
  name: Create subcontractor
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/subcontractors
  body: json
  auth: inherit
}

body:json {
  {
    "code": "SUB001",
    "nameTh": "บริษัท ขนส่งตัวอย่าง จำกัด",
    "nameEn": "Example Transport Co.",
    "legalType": "company",
    "idCardNumber": "",
    "taxId": "0105500000000",
    "contactPerson": "Somchai",
    "phone": "0812345678",
    "email": "ops@example.com",
    "website": "https://example.com",
    "address": "1 Example Rd, Bangkok",
    "designation": "Manager",
    "fleetSize": 10,
    "dispatchCenter": "Bangkok",
    "serviceRegions": [
      "central"
    ],
    "vehicleTypes": [
      "4W"
    ],
    "lineGroupId": "",
    "status": "active",
    "billingDateBasis": "delivered",
    "documentKeys": []
  }
}

assert {
  res.status: eq 201
  res.body.data: isDefined
}

docs {
  `POST /v1/subcontractors`

  Creates a carrier tenant profile. Either capability suffices.

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `fleet:manage_subcontractors`, `platform:manage_tenants`
  - **Listeners:** internal
  - **Success:** `201`; `data` has `id`, `code`, `nameTh`, `nameEn`, `status`, `fleetSize`
}
