meta {
  name: Get subcontractor
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/subcontractors/:id
  body: none
  auth: inherit
}

params:path {
  id: 00000000-0000-0000-0000-000000000000
}

assert {
  res.status: eq 200
  res.body.data: isDefined
}

docs {
  `GET /v1/subcontractors/:id`

  Full carrier profile; allowed for fleet:manage_subcontractors, a member, or the tenant's own tenant_admin. Not cached (may carry ID card number and document URLs).

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Listeners:** internal
  - **Success:** `200`; `data` has `id`, `code`, `nameTh`, `nameEn`, `status`, `fleetSize`
}
