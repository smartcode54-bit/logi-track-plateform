meta {
  name: Create company
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/companies
  body: json
  auth: inherit
}

body:json {
  {
    "nameTh": "บริษัท ตัวอย่าง จำกัด",
    "nameEn": "Example Co., Ltd.",
    "shortName": "EX",
    "taxId": "0105500000000",
    "branchType": "headquarters",
    "branchNumber": "",
    "address": "1 Example Rd, Bangkok",
    "phone": "021234567",
    "email": "info@example.com",
    "logoKey": "",
    "stampKey": "",
    "signatureKey": "",
    "signatoryName": "Somchai",
    "bankName": "Example Bank",
    "accountNumber": "000-0-00000-0",
    "accountName": "Example Co., Ltd.",
    "withholdingTaxRate": 1,
    "companyType": "issuer",
    "isActive": true,
    "maxTrucks": 50,
    "maxDrivers": 50
  }
}

assert {
  res.status: eq 201
  res.body.data: isDefined
}

docs {
  `POST /v1/companies`

  Creates a company; requires an active tenant context (403 tenant_required otherwise).

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `company:manage`
  - **Listeners:** internal
  - **Success:** `201`; `data` has `id`, `tenantId`, `nameTh`, `nameEn`, `taxId`, `branchType`
}
