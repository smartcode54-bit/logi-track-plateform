meta {
  name: Update company
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/v1/companies/:id
  body: json
  auth: inherit
}

params:path {
  id: 00000000-0000-0000-0000-000000000000
}

body:json {
  {
    "nameTh": "บริษัท ตัวอย่าง จำกัด",
    "nameEn": "Example Co., Ltd.",
    "shortName": "EX",
    "taxId": "0105500000000",
    "branchType": "headquarters",
    "branchNumber": "",
    "address": "1 Example Rd, Bangkok",
    "phone": "021234567",
    "email": "info@example.com",
    "logoKey": "",
    "stampKey": "",
    "signatureKey": "",
    "signatoryName": "Somchai",
    "bankName": "Example Bank",
    "accountNumber": "000-0-00000-0",
    "accountName": "Example Co., Ltd.",
    "withholdingTaxRate": 1,
    "companyType": "issuer",
    "isActive": true,
    "maxTrucks": 50,
    "maxDrivers": 50
  }
}

assert {
  res.status: eq 200
  res.body.data: isDefined
}

docs {
  `PATCH /v1/companies/:id`

  Partial update of a company profile.

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `company:manage`
  - **Listeners:** internal
  - **Success:** `200`; `data` has `id`, `tenantId`, `nameTh`, `nameEn`, `taxId`, `branchType`
}
