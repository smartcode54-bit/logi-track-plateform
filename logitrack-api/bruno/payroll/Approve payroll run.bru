meta {
  name: Approve payroll run
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/payroll/:id/approve
  body: json
  auth: inherit
}

params:path {
  id: 00000000-0000-0000-0000-000000000000
}

body:json {
  {}
}

assert {
  res.status: eq 200
  res.body.data: isDefined
}

docs {
  `POST /v1/payroll/:id/approve`

  Approves a pending_approval run and writes the ledger transaction. Body must be an empty JSON object.

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `hr:manage_payroll`
  - **Listeners:** internal
  - **Success:** `200`; `data` has `id`, `status`, `approvedBy`, `approvedAt`, `ledgerTransactionId`
}
