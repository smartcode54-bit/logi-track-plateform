meta {
  name: Set payroll run status
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/payroll/:id/status
  body: json
  auth: inherit
}

params:path {
  id: 00000000-0000-0000-0000-000000000000
}

body:json {
  {
    "status": "paid",
    "paymentDate": "2026-11-30",
    "paymentMethod": "transfer",
    "remarks": ""
  }
}

assert {
  res.status: eq 200
  res.body.data: isDefined
}

docs {
  `POST /v1/payroll/:id/status`

  Moves a run to pending_approval, paid, cancelled or draft (approved only via /approve). Invalid transitions are rejected.

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `hr:manage_payroll`
  - **Listeners:** internal
  - **Success:** `200`; `data` has `id`, `status`, `paymentDate`, `paymentMethod`
}
