meta {
  name: Create vehicle expense
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/expenses
  body: json
  auth: inherit
}

body:json {
  {
    "type": "fuel",
    "driverId": "00000000-0000-0000-0000-000000000000",
    "truckId": "00000000-0000-0000-0000-000000000000",
    "status": "pending",
    "date": "2026-11-20T08:30:00Z",
    "amountThb": 1500.5,
    "category": null,
    "volumeLiters": 40.5,
    "pricePerLiter": 37.05,
    "odometerKm": 120500,
    "stationTaxId": "0105500000000",
    "taxInvId": "INV-001",
    "refillLat": 13.75,
    "refillLng": 100.5,
    "note": "",
    "description": "",
    "adminNote": "",
    "receiptKey": "receipts/key-placeholder.jpg",
    "odometerKey": "odometers/key-placeholder.jpg"
  }
}

assert {
  res.status: eq 201
  res.body.data: isDefined
}

docs {
  `POST /v1/expenses`

  Creates a fuel or other expense; the capability needed depends on the type.

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `accounting:edit_fuel`, `accounting:edit_other`
  - **Listeners:** internal
  - **Success:** `201`; `data` has `id`, `tenantId`, `type`, `category`, `status`, `amountThb`
}
