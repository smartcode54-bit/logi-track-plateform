meta {
  name: Update vehicle expense
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/v1/expenses/:id
  body: json
  auth: inherit
}

params:path {
  id: 00000000-0000-0000-0000-000000000000
}

body:json {
  {
    "amountThb": 1600,
    "note": "Corrected amount"
  }
}

assert {
  res.status: eq 200
  res.body.data: isDefined
}

docs {
  `PATCH /v1/expenses/:id`

  Partially updates an expense; capability depends on the row's type.

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `accounting:edit_fuel`, `accounting:edit_other`
  - **Listeners:** internal
  - **Success:** `200`; `data` has `id`, `tenantId`, `type`, `category`, `status`, `amountThb`
}
