meta {
  name: Change password
  type: http
  seq: 9
}

post {
  url: {{publicBaseUrl}}/v1/auth/password/change
  body: json
  auth: inherit
}

body:json {
  {
    "currentPassword": "<current-password>",
    "passwordChangeTicket": "",
    "newPassword": "<new-password>"
  }
}

assert {
  res.status: eq 204
}

docs {
  `POST /v1/auth/password/change`

  Changes password either with the bearer + currentPassword, or with a passwordChangeTicket from a must-change login (ticket form ignores any Authorization header). API keys refused. Returns 204.

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Listeners:** internal,public
  - **Success:** `204`
}
