meta {
  name: Forgot password
  type: http
  seq: 7
}

post {
  url: {{publicBaseUrl}}/v1/auth/password/forgot
  body: json
  auth: none
}

body:json {
  {
    "email": "user@example.com",
    "locale": "th"
  }
}

assert {
  res.status: eq 202
  res.body.data: isDefined
}

docs {
  `POST /v1/auth/password/forgot`

  Requests a password reset email. Always 202 with empty body regardless of whether the email exists.

  - **Auth:** None (anonymous)
  - **Listeners:** internal,public
  - **Success:** `202`
}
