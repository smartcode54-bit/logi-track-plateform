meta {
  name: Reset password
  type: http
  seq: 8
}

post {
  url: {{publicBaseUrl}}/v1/auth/password/reset
  body: json
  auth: none
}

body:json {
  {
    "token": "<reset-token>",
    "newPassword": "<new-password>"
  }
}

assert {
  res.status: eq 204
}

docs {
  `POST /v1/auth/password/reset`

  Completes a reset with the emailed token and sets a new password; revokes sessions. Returns 204.

  - **Auth:** None (anonymous)
  - **Listeners:** internal,public
  - **Success:** `204`
}
