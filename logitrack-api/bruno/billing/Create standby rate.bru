meta {
  name: Create standby rate
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/v1/billing/standby-rates
  body: json
  auth: inherit
}

body:json {
  {
    "customerId": "00000000-0000-0000-0000-000000000000",
    "rateThb": 800.0,
    "effectiveFromDateStr": "2026-11-01",
    "note": "Standby per event"
  }
}

assert {
  res.status: eq 201
  res.body.data: isDefined
}

docs {
  `POST /v1/billing/standby-rates`

  Creates a flat per-event standby rate. Writes need an effective tenant and only the own fleet (403 own_fleet_only otherwise). Unknown query parameters give 400.

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `accounting:edit_rate_card`
  - **Listeners:** internal
  - **Success:** `201`; `data` has `id`, `customerId`, `rateThb`, `effectiveFromDateStr`, `note`, `voided`
}
