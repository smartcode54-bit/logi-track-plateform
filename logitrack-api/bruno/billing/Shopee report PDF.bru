meta {
  name: Shopee report PDF
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/v1/billing/shopee-report.pdf?customerId=00000000-0000-0000-0000-000000000000&year=2026&month=11
  body: none
  auth: inherit
}

params:query {
  customerId: 00000000-0000-0000-0000-000000000000
  year: 2026
  month: 11
  ~half: full
}

assert {
  res.status: eq 302
}

docs {
  `GET /v1/billing/shopee-report.pdf`

  Answers 302 to the stored PDF render, or 202 {jobId} while it renders. Responds with a redirect, not JSON.

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `accounting:shopee_report`
  - **Listeners:** internal
  - **Success:** `302`; `data` has `jobId`
  - **Query `customerId`** (required): customer id
  - **Query `year`** (required): period year
  - **Query `month`** (required): period month
  - **Query `half`**: full|first|second
}
