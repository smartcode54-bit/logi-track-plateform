meta {
  name: List fuel adjustments
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/billing/fuel-adjustments
  body: none
  auth: inherit
}

params:query {
  ~customerId: 00000000-0000-0000-0000-000000000000
  ~includeVoided: false
}

assert {
  res.status: eq 200
  res.body.data: isDefined
}

docs {
  `GET /v1/billing/fuel-adjustments`

  Lists fuel adjustment rules (not paginated).

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `accounting:view_rate_card`
  - **Listeners:** internal
  - **Success:** `200`; `data` has `id`, `customerId`, `effectiveFromDateStr`, `rateMultiplier`, `addThbPerTrip`, `announcementNote`
  - **Query `customerId`**: filter by customer id
  - **Query `includeVoided`**: include voided rows (true|false)
}
