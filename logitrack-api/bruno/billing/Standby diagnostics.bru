meta {
  name: Standby diagnostics
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/v1/billing/standby-diagnostics?year=2026&month=11
  body: none
  auth: inherit
}

params:query {
  ~customerId: 00000000-0000-0000-0000-000000000000
  year: 2026
  month: 11
}

assert {
  res.status: eq 200
  res.body.data: isDefined
}

docs {
  `GET /v1/billing/standby-diagnostics`

  Diagnoses standby records of the period (unpriced, no customer, no rate).

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `accounting:billing_document`
  - **Listeners:** internal
  - **Success:** `200`
  - **Query `customerId`**: customer id, or 'all'
  - **Query `year`** (required): period year
  - **Query `month`** (required): period month
}
