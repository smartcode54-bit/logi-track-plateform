meta {
  name: Regenerate statement documents
  type: http
  seq: 26
}

post {
  url: {{baseUrl}}/v1/billing/statements/:id/documents/regenerate
  body: json
  auth: inherit
}

params:path {
  id: 00000000-0000-0000-0000-000000000000
}

body:json {
  {
    "showActualPickup": false
  }
}

assert {
  res.status: eq 202
  res.body.data: isDefined
}

docs {
  `POST /v1/billing/statements/:id/documents/regenerate`

  Queues a documents.regenerate job (202 {jobId}). Body is optional.

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `accounting:manage_statements`
  - **Listeners:** internal
  - **Success:** `202`; `data` has `jobId`
}
