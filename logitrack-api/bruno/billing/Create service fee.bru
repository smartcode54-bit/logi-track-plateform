meta {
  name: Create service fee
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/v1/billing/service-fees
  body: json
  auth: inherit
}

body:json {
  {
    "customerId": "00000000-0000-0000-0000-000000000000",
    "feeType": "extra_stop",
    "customTypeName": null,
    "amountThb": 300.0,
    "unit": "per_stop",
    "note": "Flat extra-stop fee"
  }
}

assert {
  res.status: eq 201
  res.body.data: isDefined
}

docs {
  `POST /v1/billing/service-fees`

  Creates a service fee. feeType: extra_stop, waiting_time, special_handling, service_charge, standby, custom (custom needs customTypeName). Writes need an effective tenant and only the own fleet (403 own_fleet_only otherwise). Unknown query parameters give 400.

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `accounting:edit_rate_card`
  - **Listeners:** internal
  - **Success:** `201`; `data` has `id`, `customerId`, `feeType`, `amountThb`, `unit`, `note`
}
