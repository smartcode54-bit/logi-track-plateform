meta {
  name: Get statement
  type: http
  seq: 24
}

get {
  url: {{baseUrl}}/v1/billing/statements/:id
  body: none
  auth: inherit
}

params:path {
  id: 00000000-0000-0000-0000-000000000000
}

assert {
  res.status: eq 200
  res.body.data: isDefined
}

docs {
  `GET /v1/billing/statements/:id`

  Returns one statement with totals and counts.

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `accounting:billing_result`
  - **Listeners:** internal
  - **Success:** `200`; `data` has `id`, `customerId`, `invoiceNumber`, `period`, `totalAmount`, `status`
}
