assert {
  res.status: eq 201
  res.body.data: isDefined
}

docs {
  `POST /v1/trucks`

  Creates a truck. Fields are partial-input (absent vs null are distinguished); licensePlate is required and validated.

  - **Auth:** Bearer access token (`{{accessToken}}`, set by `auth/Login`)
  - **Capabilities:** `fleet:create_truck`
  - **Listeners:** internal
  - **Success:** `201`; `data` has `id`, `tenantId`, `licensePlate`, `status`, `type`, `ownershipType`
}
