{
  "source": "logitrack-web/lib/billingDate.test.ts",
  "sourceCommit": "4f552099",
  "note": "8 Vitest cases ported to internal/platform/clock. A {\"$local\"} argument is a date picked in the host zone; Go replays it in several zones.",
  "cases": [
    {
      "name": "bangkokMidnightFromDateStr > resolves a date to Bangkok midnight, i.e. 17:00Z the previous day",
      "line": 10,
      "checks": [
        {
          "fn": "bangkokMidnightFromDateStr",
          "args": [
            "2026-08-16"
          ],
          "want": {
            "$date": "2026-08-15T17:00:00.000Z"
          }
        }
      ]
    },
    {
      "name": "bangkokMidnightFromDateStr > does not depend on the host timezone",
      "line": 14,
      "checks": [
        {
          "fn": "bangkokMidnightFromDateStr",
          "args": [
            "2026-01-01"
          ],
          "want": {
            "$date": "2025-12-31T17:00:00.000Z"
          }
        }
      ]
    },
    {
      "name": "bangkokMidnightFromDateStr > is 7 hours earlier than the UTC-midnight form the old helper produced",
      "line": 20,
      "checks": [
        {
          "fn": "msBeforeUtcMidnight",
          "args": [
            "2026-08-16"
          ],
          "want": 25200000
        }
      ]
    },
    {
      "name": "bangkokMidnightFromDateStr > rejects anything that is not a yyyy-MM-dd date",
      "line": 26,
      "checks": [
        {
          "fn": "bangkokMidnightFromDateStr",
          "args": [
            ""
          ],
          "want": null
        },
        {
          "fn": "bangkokMidnightFromDateStr",
          "args": [
            "16/08/2026"
          ],
          "want": null
        },
        {
          "fn": "bangkokMidnightFromDateStr",
          "args": [
            "2026-8-6"
          ],
          "want": null
        }
      ]
    },
    {
      "name": "bangkokDateStr > reads an instant on the Bangkok calendar, not the UTC one",
      "line": 34,
      "checks": [
        {
          "fn": "bangkokDateStr",
          "args": [
            {
              "$date": "2026-08-15T17:00:00.000Z"
            }
          ],
          "want": "2026-08-16"
        },
        {
          "fn": "bangkokDateStr",
          "args": [
            {
              "$date": "2026-08-16T16:59:59.000Z"
            }
          ],
          "want": "2026-08-16"
        },
        {
          "fn": "bangkokDateStr",
          "args": [
            {
              "$date": "2026-08-16T17:00:00.000Z"
            }
          ],
          "want": "2026-08-17"
        }
      ]
    },
    {
      "name": "bangkokDateStr > round-trips with bangkokMidnightFromDateStr",
      "line": 40,
      "checks": [
        {
          "fn": "bangkokDateStr(bangkokMidnightFromDateStr)",
          "args": [
            "2026-01-01"
          ],
          "want": "2026-01-01"
        },
        {
          "fn": "bangkokDateStr(bangkokMidnightFromDateStr)",
          "args": [
            "2026-08-16"
          ],
          "want": "2026-08-16"
        },
        {
          "fn": "bangkokDateStr(bangkokMidnightFromDateStr)",
          "args": [
            "2026-12-31"
          ],
          "want": "2026-12-31"
        }
      ]
    },
    {
