  "note": "12 Vitest cases ported to compute.PeriodKey / PeriodOf / PeriodLocks. lockFor returns the locking statement or null.",
  "cases": [
    {
      "name": "billingPeriodKey > zero-pads the month so month 7 and month 70 can never collide",
      "line": 25,
      "checks": [
        {
          "fn": "billingPeriodKey",
          "args": [
            "c",
            2026,
            7
          ],
          "want": "c__2026-07"
        },
        {
          "fn": "billingPeriodKey",
          "args": [
            "c",
            2026,
            12
          ],
          "want": "c__2026-12"
        }
      ]
    },
    {
      "name": "billingPeriodKey > keys are per customer — the same month for two customers is two periods",
      "line": 30,
      "checks": [
        {
          "fn": "billingPeriodKey",
          "args": [
            "a",
            2026,
            7
          ],
          "want": "a__2026-07"
        },
        {
          "fn": "billingPeriodKey",
          "args": [
            "b",
            2026,
            7
          ],
          "want": "b__2026-07"
        }
      ]
    },
    {
