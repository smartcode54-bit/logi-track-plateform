# logitrack-api local configuration template. Names come from developer-spec.md §16.1 (canonical);
# `make env-check` verifies this file and the compose environment against it.
# Copy with `make env` (fills local-only secrets with random values) — never commit .env.
# Secret names are left blank here: locally `make env` fills them, elsewhere they come from the secret store.

# --- Process, logging, ingress ---
APP_ENV=local
LOG_LEVEL=debug
LOG_FORMAT=json
SHUTDOWN_TIMEOUT=30s
METRICS_ADDR=:9090
PPROF_ENABLED=false
API_INTERNAL_ADDR=:8080
API_PUBLIC_ADDR=:8081
PUBLIC_ROUTE_GROUPS=/v1/mobile,/v1/auth,/public/v1,/evidence,/healthz
TRUSTED_PROXY_CIDRS=172.16.0.0/12
PUBLIC_API_BASE_URL=http://api.localhost
PUBLIC_WEB_BASE_URL=http://localhost:3000
WEB_FLAG_OVERRIDES=
GO_API_INTERNAL_URL=http://api:8080

# --- PostgreSQL 18 (one URL per process, R66/R87) ---
DATABASE_URL=
MIGRATE_DATABASE_URL=
ETL_DATABASE_URL=
DATABASE_MAX_CONNS=8
DATABASE_MIN_CONNS=1
DATABASE_MIGRATE_ON_START=false
POSTGRES_USER=postgres
POSTGRES_DB=logitrack
POSTGRES_PASSWORD=

# --- Redis ---
REDIS_URL=
REDIS_KEY_PREFIX=lt:local:
REDIS_TLS=false

# --- Cache, idempotency, rate limits ---
CACHE_TTL_HUBS=10m
CACHE_TTL_RATECARD=10m
CACHE_TTL_SETTINGS=1m
IDEMPOTENCY_TTL=168h
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/15m
RATE_LIMIT_PUBLIC_FORMS=5/1m
RATE_LIMIT_EVIDENCE=60/1m

# --- RabbitMQ and outbox ---
RABBITMQ_URL=
RABBITMQ_PREFETCH=
WORKER_CONSUMERS=all
OUTBOX_RELAY_INTERVAL=200ms
OUTBOX_BATCH_SIZE=500
RABBITMQ_DEFAULT_USER=logitrack
RABBITMQ_DEFAULT_PASS=

# --- Object storage (MinIO locally) ---
S3_ENDPOINT=http://minio:9000
S3_PRESIGN_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=logitrack
S3_PUBLIC_BUCKET=logitrack-public
S3_USE_PATH_STYLE=true
S3_USE_SSL=false
S3_PUBLIC_BASE_URL=http://localhost:9000/logitrack-public
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost
S3_PRESIGN_GET_TTL=1h
S3_PRESIGN_PUT_TTL=15m
UPLOAD_MAX_BYTES=10485760
MINIO_ROOT_USER=logitrack-admin
MINIO_ROOT_PASSWORD=
IMAGES_THUMBNAIL_ENABLED=false
PDF_FONT_DIR=/app/fonts

# --- Auth ---
JWT_SIGNING_KEY_FILE=/run/secrets/logitrack/jwt-ed25519.pem
JWT_PREVIOUS_KEY_FILE=
JWT_ACTIVE_KID=
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=logitrack-local
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_WEB=168h
REFRESH_TOKEN_TTL_MOBILE=2160h
PASSWORD_RESET_TTL=30m
PASSWORD_MIN_LENGTH=10
ARGON2_MEMORY_KB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2
GOOGLE_OIDC_ALLOWED_CLIENT_IDS=
PLATFORM_ADMIN_EMAILS=admin@logitrack.test
FIREBASE_SCRYPT_SIGNER_KEY=
FIREBASE_SCRYPT_SALT_SEPARATOR=
FIREBASE_SCRYPT_ROUNDS=
FIREBASE_SCRYPT_MEM_COST=
FIREBASE_PROJECT_ID=
AUTH_FIREBASE_BRIDGE_MODE=off
API_KEY_PEPPER=
RELEASE_API_KEY=
MOBILE_ATTESTATION_MODE=off
MOBILE_VERSION_FLOOR_ENFORCE=false
EVIDENCE_TOKEN_TTL_DAYS=0
MOBILE_SSE_ENABLED=false

# --- Tenancy, ETL, coexistence ---
OWN_FLEET_TENANT_ID=
PG_OWNED_DOMAINS=all
GOOGLE_APPLICATION_CREDENTIALS=
ETL_FIRESTORE_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)
ETL_GCS_BUCKET=
ETL_SYNC_ENABLED=false
ETL_SYNC_INTERVAL=5m
ETL_MIRROR_COLLECTIONS=
COMPAT_PROJECTION_ENABLED=false
COMPAT_PROJECTION_COLLECTIONS=

# --- Integrations (disabled locally; mocks profile serves *_BASE_URL) ---
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
FCM_ENABLED=false
LINE_CHANNEL_ACCESS_TOKEN=
LINE_NOTIFY_ENABLED=false
LINE_API_BASE_URL=http://mocks:8080/line
LINE_CHANNEL_SECRET=
CARTRACK_API_USERNAME=
CARTRACK_API_PASSWORD=
CARTRACK_API_BASE_URL=http://mocks:8080/cartrack
CARTRACK_SYNC_ENABLED=false
FUEL_MONTHLY_SNAPSHOT_ENABLED=false
BANGCHAK_API_BASE_URL=http://mocks:8080/bangchak
GOOGLE_MAPS_SERVER_API_KEY=
DISTANCE_MATRIX_ENABLED=false
GOOGLE_MAPS_STATIC_KEY=
GOOGLE_CLOUD_VISION_API_KEY=
OCR_PROXY_ENABLED=false
EVIDENCE_BASE_URL=http://api.localhost/evidence
EVIDENCE_PRESIGN_TTL=15m

# --- Email (mailpit locally) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_FROM=no-reply@logitrack.test
SMTP_FROM_NAME=LogiTrack
SMTP_STARTTLS=false
SMTP_PASSWORD=
EMAIL_ENABLED=true
NOTIFY_ADMIN_ON_DRIVER_MESSAGE=false
TURNSTILE_SECRET_KEY=

# --- Realtime ---
SSE_PING_INTERVAL=25s
SSE_MAX_CONN_PER_USER=5
RTLOG_MAXLEN=10000
RTLOG_TTL=24h

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=
OTEL_TRACES_SAMPLER_ARG=1
SENTRY_DSN=

# --- Seed (local and CI only) ---
SEED_PROFILE=smoke
SEED_RANDOM_SEED=20261009
SEED_ANCHOR_DATE=
SEED_NAMESPACE=
SEED_DEFAULT_PASSWORD=

# --- Edge: Caddy, tunnel, image tags ---
WEB_DOMAIN=http://localhost
API_PUBLIC_DOMAIN=http://api.localhost
MEDIA_DOMAIN=http://media.localhost
ACME_EMAIL=
TUNNEL_TOKEN=
API_IMAGE_TAG=local
WEB_IMAGE_TAG=local
