{
  "firestore": {
    "database": "(default)",
    "location": "asia-southeast3",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "codebase": "logi-truck",
    "runtime": "nodejs22",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.local"
    ],
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" ci",
      "npm --prefix \"$RESOURCE_DIR\" run build",
      "npm --prefix \"$RESOURCE_DIR\" run discover"
    ]
  },
  "hosting": {
    "public": "hosting-placeholder",
    "predeploy": [
      "node \"$PROJECT_DIR/scripts/check-hosting-redirect.mjs\" \"$PROJECT_DIR/firebase.json\""
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/:path*",
        "destination": "https://WEB_DOMAIN/:path",
        "type": 301
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  }
}
