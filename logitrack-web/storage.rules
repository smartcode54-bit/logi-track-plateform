rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Same as Firestore: ID tokens do not carry app_check; use Console App Check enforcement per product.
    function isAppCheckVerified() {
      return true;
    }

    // Truck images
    match /trucks/{allPaths=**} {
      allow read: if true;
      allow write: if isAppCheckVerified() && request.auth != null;
    }

    // Subcontractor documents
    match /subcontractors/{allPaths=**} {
      allow read: if true;
      allow write: if isAppCheckVerified() && request.auth != null;
    }

    // Driver documents & profiles (admin: edit driver uses drivers/profile/ and drivers/documents/)
    match /drivers/{allPaths=**} {
      allow read: if true;
      allow write: if isAppCheckVerified() && request.auth != null;
    }

    // First-mile and Line-haul check-in photos (mobile app uploads here)
    match /checkin/{allPaths=**} {
      allow read: if true;
      allow write: if isAppCheckVerified() && request.auth != null;
    }

    // Trip record photos (loading/delivery phase evidence from mobile app)
    match /trip_records/{allPaths=**} {
      allow read: if true;
      allow write: if isAppCheckVerified() && request.auth != null;
    }

    // Incident report photos (รายงานปัญหา / delivery delay from mobile app)
    match /incident_reports/{allPaths=**} {
      allow read: if true;
      allow write: if isAppCheckVerified() && request.auth != null;
    }

    // Vehicle expense receipts (บิลน้ำมัน / รูปบิลจากแอปจัดการรถ)
    match /vehicle_expenses/{allPaths=**} {
      allow read: if true;
      allow write: if isAppCheckVerified() && request.auth != null;
    }

    // Maintenance receipts / invoice photos (แอปคนขับอัปโหลดที่ maintenance/{taskId}/...)
    match /maintenance/{allPaths=**} {
      allow read: if true;
      allow write: if isAppCheckVerified() && request.auth != null;
    }

    // Chat media (รูปในแชท Admin–Driver จากแอปคนขับ)
    match /chat_media/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAppCheckVerified() && request.auth != null;
    }

    // Leave request evidence (รูปหลักฐานคำขอลาจากแอปคนขับ)
    // Path: leave_evidence/{userId}/{timestamp}_{index}.jpg
    match /leave_evidence/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAppCheckVerified() && request.auth != null && request.auth.uid == userId;
    }

    // Customer logos
    match /customers/{allPaths=**} {
      allow read: if true;
      allow write: if isAppCheckVerified() && request.auth != null;
    }

    // Default: deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
