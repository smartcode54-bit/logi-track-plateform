{
  "name": "logi-track",
  "version": "1.4.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack && node scripts/flatten-next-flight-paths.mjs",
    "start": "next start",
    "lint": "eslint",
    "clean": "pnpm exec rimraf .next out .turbo .firebase",
    "deploy": "pnpm run build && firebase deploy",
    "deploy:dev": "node -e \"const fs=require('fs');const s='../envs/.env.dev.web';if(fs.existsSync(s))fs.copyFileSync(s,'.env.production');\" && node -e \"const fs=require('fs');if(fs.existsSync('.env.local')){fs.renameSync('.env.local','.env.local.bak')}\" && pnpm run clean && pnpm run build && node -e \"const fs=require('fs');if(fs.existsSync('.env.local.bak')){fs.renameSync('.env.local.bak','.env.local')}\" && firebase deploy --project logi-track-wrt-dev",
    "deploy:prod": "node -e \"const fs=require('fs');const s='../envs/.env.prod.web';if(fs.existsSync(s))fs.copyFileSync(s,'.env.production');\" && node -e \"const fs=require('fs');if(fs.existsSync('.env.local')){fs.renameSync('.env.local','.env.local.bak')}\" && pnpm run clean && pnpm run build && node -e \"const fs=require('fs');if(fs.existsSync('.env.local.bak')){fs.renameSync('.env.local.bak','.env.local')}\" && firebase deploy --config firebase.prod.json --project logitrack-prod",
    "deploy:clean": "pnpm run clean && pnpm run build && firebase deploy",
    "prepare": "husky",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/list": "^6.1.20",
    "@fullcalendar/multimonth": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@types/leaflet": "^1.9.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.7.0",
    "firebase-admin": "^13.6.0",
    "fullcalendar": "^6.1.20",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "leaflet-geosearch": "^4.2.2",
    "lucide-react": "^0.562.0",
    "next": "16.1.1",
    "next-themes": "^0.4.6",
    "playwright": "^1.58.1",
    "react": "19.2.3",
    "react-day-picker": "^9.13.0",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.70.0",
    "react-leaflet": "^4.2.1",
    "shared-docs": "*",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "husky": "^9.1.7",
    "jsdom": "^29.0.0",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}