rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // App Check is not exposed on ID tokens in rules (request.auth.token has no app_check claim).
    // Use Firebase Console → App Check → enforce per product (e.g. Firestore) for attestation.
    // This helper remains so existing rule structure stays readable; auth + data checks below do the real access control.
    function isAppCheckVerified() {
      return true;
    }

    // Matches web getRole(): admin via boolean claim OR role string (some accounts only have role == "admin").
    function isWebAdmin() {
      return request.auth.token.admin == true || request.auth.token.get('role', '') == 'admin';
    }

    // Customer role with a linked customer ID
    function isCustomer() {
      return request.auth.token.get('role', '') == 'customer'
        && request.auth.token.get('customerScopeId', '') != '';
    }

    // Role matrix stores capability keys as matrix row ids, e.g. security_view_audit (see capabilities.ts / roles UI).
    function canReadSecurityEvents() {
      return isWebAdmin() || (
        exists(/databases/$(database)/documents/permissions_config/$(request.auth.token.get('role', ''))) &&
        get(/databases/$(database)/documents/permissions_config/$(request.auth.token.get('role', '')))
          .data.get('capabilities', {}).get('security_view_audit', false) == true
      );
    }

    // Hub→SOC distances (Google Distance Matrix cache). Read by web map & admin; write by admin/API.
    match /hub_soc_distances/{docId} {
      allow read: if request.auth != null;
      allow write: if isAppCheckVerified() && request.auth != null && isWebAdmin();
    }
    // SOC→Hub distances (Google Distance Matrix cache). Read by web map & admin; write by admin/API.
    match /soc_hub_distances/{docId} {
      allow read: if request.auth != null;
      allow write: if isAppCheckVerified() && request.auth != null && isWebAdmin();
    }

    // Users: own doc read/write for profile/fcmTokens; admins can read/write all (e.g. Security Center User Management).
    match /users/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        isWebAdmin()
      );
      allow write: if isAppCheckVerified() && request.auth != null && (
        request.auth.uid == uid ||
        isWebAdmin()
      );
    }

    // Chats: Admins read all chats; drivers only their own (driverId == authId).
    // status, assignedAdminId, priority, lastReadByAdmin (Map), lastMessage, lastMessageAt.
    match /chats/{chatId} {
      allow read: if request.auth != null && (
        isWebAdmin() ||
        resource.data.driverId == request.auth.uid
      );
      allow create: if isAppCheckVerified() && request.auth != null && (
        isWebAdmin() ||
        (request.resource.data.driverId == request.auth.uid && request.resource.data.assignedAdminId == null)
      );
      allow update, delete: if isAppCheckVerified() && request.auth != null && (
        isWebAdmin() ||
        resource.data.driverId == request.auth.uid
      );

      // Messages subcollection: same visibility as parent chat.
      match /messages/{messageId} {
        allow read: if request.auth != null && (
          isWebAdmin() ||
          get(/databases/$(database)/documents/chats/$(chatId)).data.driverId == request.auth.uid
        );
        allow write: if isAppCheckVerified() && request.auth != null && (
          isWebAdmin() ||
          get(/databases/$(database)/documents/chats/$(chatId)).data.driverId == request.auth.uid
        );
      }
    }

    // Incident reports: drivers create/read own only (driverId = auth UID or driver doc id); admins full; customers can read all.
    match /incidentReport/{reportId} {
      allow read: if request.auth != null && (
        isWebAdmin() ||
        isCustomer() ||
        resource.data.driverId == request.auth.uid ||
        (resource.data.get('driverId', '') != '' && get(/databases/$(database)/documents/drivers/$(resource.data.driverId)).data.get('authId', '') == request.auth.uid)
      );
      allow create: if isAppCheckVerified() && request.auth != null && (
        request.resource.data.driverId == request.auth.uid ||
        (request.resource.data.get('driverId', '') != '' && get(/databases/$(database)/documents/drivers/$(request.resource.data.driverId)).data.get('authId', '') == request.auth.uid)
      );
      allow update, delete: if isAppCheckVerified() && request.auth != null && (
        isWebAdmin() ||
        resource.data.driverId == request.auth.uid ||
        (resource.data.get('driverId', '') != '' && get(/databases/$(database)/documents/drivers/$(resource.data.driverId)).data.get('authId', '') == request.auth.uid)
      );
    }

    // Broadcasts: history of sent broadcasts. Drivers can read (for Broadcast list); only admins can write.
    match /broadcasts/{broadcastId} {
      allow read: if request.auth != null;
      allow write: if isAppCheckVerified() && request.auth != null && isWebAdmin();
    }

    // Customers / LSP profiles (for billing, driver IDs). Admin only.
    match /customers/{customerId} {
      allow read: if request.auth != null && isWebAdmin();
      allow write: if isAppCheckVerified() && request.auth != null && isWebAdmin();
    }

    // Customer-specific route rate cards for billing estimates.
    match /customer_rate_entries/{docId} {
      allow read: if request.auth != null && isWebAdmin();
      allow write: if isAppCheckVerified() && request.auth != null && isWebAdmin();
    }

    // Customer fuel-price-linked billing adjustments by effective date.
    match /customer_fuel_rate_adjustments/{docId} {
      allow read: if request.auth != null && isWebAdmin();
      allow write: if isAppCheckVerified() && request.auth != null && isWebAdmin();
    }

    // Customer service fees (extra stop, waiting time, special handling, etc.).
    match /customer_service_fees/{docId} {
      allow read: if request.auth != null && isWebAdmin();
      allow create, update: if isAppCheckVerified() && request.auth != null && isWebAdmin()
        && request.resource.data.customerId is string
        && request.resource.data.amountThb is number
        && request.resource.data.amountThb >= 0;
      allow delete: if isAppCheckVerified() && request.auth != null && isWebAdmin();
    }

    // Monthly retail fuel snapshots (written by Cloud Functions only).
    match /fuel_monthly_snapshots/{docId} {
      allow read: if request.auth != null && isWebAdmin();
      allow write: if false;
    }

    // Unified Tasks: Admin full; Drivers read, create (manual check-in), update (check-in, Completed) own tasks.
    // driverId on task = drivers collection document id (not always Auth UID); legacy tasks may store UID in driverId.
    match /tasks/{taskId} {
      allow read: if request.auth != null;
      allow create: if isAppCheckVerified() && request.auth != null && (
        isWebAdmin() ||
        (request.resource.data.get('driverId', '') != '' &&
          exists(/databases/$(database)/documents/drivers/$(request.resource.data.driverId)) &&
          get(/databases/$(database)/documents/drivers/$(request.resource.data.driverId)).data.get('authId', '') == request.auth.uid)
      );
      allow update, delete: if request.auth != null && (
        isWebAdmin() ||
        resource.data.driverId == request.auth.uid ||
        (resource.data.get('driverId', '') != '' &&
          exists(/databases/$(database)/documents/drivers/$(resource.data.driverId)) &&
          get(/databases/$(database)/documents/drivers/$(resource.data.driverId)).data.get('authId', '') == request.auth.uid)
      );
    }

    // Unified Check-in records: Drivers create/read own; Admins read all.
    match /checkin/{checkinId} {
      allow read: if request.auth != null && (
        isWebAdmin() ||
        resource.data.driverId == request.auth.uid
      );
      allow create: if isAppCheckVerified() && request.auth != null;
      allow update, delete: if isAppCheckVerified() && request.auth != null && (
        isWebAdmin() ||
        resource.data.driverId == request.auth.uid
      );
    }

    // Role-permission config: admin full; each signed-in user may read their own role doc (for capability UI).
    match /permissions_config/{roleId} {
      allow read: if request.auth != null && (
        isWebAdmin() ||
        roleId == request.auth.token.get('role', '')
      );
      allow write: if isAppCheckVerified() && request.auth != null && isWebAdmin();
    }

    // App-wide settings (e.g. mobile min version). Authenticated read; admin write.
    match /settings/{docId} {
      allow read: if request.auth != null;
      allow write: if isAppCheckVerified() && request.auth != null && isWebAdmin();
    }

    function driverAuthId(driverId) {
      return exists(/databases/$(database)/documents/drivers/$(driverId))
        ? get(/databases/$(database)/documents/drivers/$(driverId)).data.get('authId', '')
        : '';
    }

    // Normalized subcontractor / partner id for heartbeat (null must match client empty string).
    function driverSubcontractorId(driverId) {
      return !exists(/databases/$(database)/documents/drivers/$(driverId))
        ? ''
        : (
            get(/databases/$(database)/documents/drivers/$(driverId)).data.get('subcontractorId', '') == null
            ? ''
            : string(get(/databases/$(database)/documents/drivers/$(driverId)).data.get('subcontractorId', ''))
          );
    }

    // Drivers: any authenticated read (dashboard counts); admin or own doc for write.
    match /drivers/{driverId} {
      allow read: if request.auth != null;
      allow create: if isAppCheckVerified() && request.auth != null && isWebAdmin();
      allow update, delete: if isAppCheckVerified() && request.auth != null && (
        isWebAdmin() ||
        resource.data.authId == request.auth.uid
      );

      // Mobile app heartbeat: one doc per device install. Driver self-write only; admin/partner read for Security Center.
      match /mobile_installations/{installId} {
        allow read: if request.auth != null && (
          isWebAdmin() ||
          (request.auth.token.get('role', '') == 'partner' &&
            resource.data.get('partnerId', '') != '' &&
            resource.data.get('partnerId', '') == request.auth.token.get('partnerScopeId', '')) ||
          driverAuthId(driverId) == request.auth.uid
        );
        allow create: if isAppCheckVerified() && request.auth != null &&
          driverAuthId(driverId) == request.auth.uid &&
          request.resource.data.get('driverId', '') == driverId &&
          request.resource.data.get('partnerId', '') == driverSubcontractorId(driverId);
        allow update: if isAppCheckVerified() && request.auth != null &&
          driverAuthId(driverId) == request.auth.uid &&
          request.resource.data.get('driverId', '') == driverId &&
          request.resource.data.get('partnerId', '') == driverSubcontractorId(driverId);
        allow delete: if false;
      }
    }

    // Trip records: Admin full; Drivers read/create/update own only (driverId = auth UID or driver doc id).
    match /trip_records/{tripId} {
      allow read: if request.auth != null;
      allow create: if isAppCheckVerified() && request.auth != null && (
        request.resource.data.driverId == request.auth.uid ||
        (request.resource.data.get('driverId', '') != '' && get(/databases/$(database)/documents/drivers/$(request.resource.data.driverId)).data.get('authId', '') == request.auth.uid)
      );
      allow update, delete: if isAppCheckVerified() && request.auth != null && (
        isWebAdmin() ||
        resource.data.driverId == request.auth.uid ||
        (resource.data.get('driverId', '') != '' && get(/databases/$(database)/documents/drivers/$(resource.data.driverId)).data.get('authId', '') == request.auth.uid)
      );
    }

    // Vehicle locations (Cartrack sync): admin read for dashboard map; write by Cloud Function only.
    match /vehicle_locations/{locId} {
      allow read: if request.auth != null;
      allow write: if isAppCheckVerified() && request.auth != null && isWebAdmin();
    }

    // Trucks: any authenticated read (Driver app reads truck for assignment history); admin write.
    match /trucks/{truckId} {
      allow read: if request.auth != null;
      allow write: if isAppCheckVerified() && request.auth != null && isWebAdmin();
    }

    // Truck assignments: Admin write; Drivers read own (driverId in doc = driver doc id).
    match /truckAssignment/{assignmentId} {
      allow read: if request.auth != null && (
        isWebAdmin() ||
        (resource.data.get('driverId', '') != '' && get(/databases/$(database)/documents/drivers/$(resource.data.driverId)).data.get('authId', '') == request.auth.uid)
      );
      allow write: if isAppCheckVerified() && request.auth != null && isWebAdmin();
    }

    // Waitlist: anyone can create (signup); admin read/delete.
    match /waitlist/{docId} {
      allow create: if isAppCheckVerified();
      allow read, delete: if isAppCheckVerified() && request.auth != null && isWebAdmin();
      allow update: if isAppCheckVerified() && request.auth != null && isWebAdmin();
    }

    // Subcontractors: admin only.
    match /subcontractors/{docId} {
      allow read: if request.auth != null && isWebAdmin();
      allow write: if isAppCheckVerified() && request.auth != null && isWebAdmin();
    }

    // Hubs: authenticated read; drivers can create (add new Hub/SOC from Manual Check-in); admin update/delete.
    match /hubs/{hubId} {
      allow read: if request.auth != null;
      allow create: if isAppCheckVerified() && request.auth != null;
      allow update, delete: if isAppCheckVerified() && request.auth != null && isWebAdmin();
    }

    // System metadata: admin read/write.
    match /metadata/{docId} {
      allow read: if request.auth != null && isWebAdmin();
      allow write: if isAppCheckVerified() && request.auth != null && isWebAdmin();
    }

    // Required shape for admin-created vehicle expenses (import / backfill).
    function vehicleExpenseAdminCreateValid() {
      let d = request.resource.data;
      return d.driverId is string
        && d.driverId.size() > 0
        && d.type is string
        && (d.type == 'fuel' || d.type == 'other')
        && d.date is timestamp
        && d.amount is number
        && d.status is string
        && (d.status == 'PENDING' || d.status == 'APPROVED' || d.status == 'REJECTED');
    }

    // Vehicle expenses: admin full; drivers create/read/update own only (driverId = auth UID or driver doc id).
    match /vehicle_expenses/{docId} {
      allow read: if request.auth != null && (
        isWebAdmin() ||
        resource.data.driverId == request.auth.uid ||
        (resource.data.get('driverId', '') != '' && get(/databases/$(database)/documents/drivers/$(resource.data.driverId)).data.get('authId', '') == request.auth.uid)
      );
      allow create: if isAppCheckVerified() && request.auth != null && (
        (isWebAdmin() && vehicleExpenseAdminCreateValid()) ||
        request.resource.data.driverId == request.auth.uid ||
        (request.resource.data.get('driverId', '') != '' && get(/databases/$(database)/documents/drivers/$(request.resource.data.driverId)).data.get('authId', '') == request.auth.uid)
      );
      allow update, delete: if isAppCheckVerified() && request.auth != null && (
        isWebAdmin() ||
        resource.data.driverId == request.auth.uid ||
        (resource.data.get('driverId', '') != '' && get(/databases/$(database)/documents/drivers/$(resource.data.driverId)).data.get('authId', '') == request.auth.uid)
      );
    }

    // Maintenance: admin full; assigned driver may read/update rows for their truck (mobile PM / receipt).
    function driverMaintenanceTruckId() {
      let did = request.auth.token.get('driverId', '');
      return did != '' && exists(/databases/$(database)/documents/drivers/$(did))
        ? (
            get(/databases/$(database)/documents/drivers/$(did)).data.get('currentAssignment', {}).get('truckId', '') != ''
            ? get(/databases/$(database)/documents/drivers/$(did)).data.get('currentAssignment', {}).get('truckId', '')
            : get(/databases/$(database)/documents/drivers/$(did)).data.get('truckId', '')
          )
        : '';
    }

    function maintenanceVisibleToAssignedDriver(truckId) {
      return truckId != ''
        && driverMaintenanceTruckId() != ''
        && truckId == driverMaintenanceTruckId();
    }

    match /maintenance/{docId} {
      allow read: if request.auth != null && (
        isWebAdmin() ||
        maintenanceVisibleToAssignedDriver(resource.data.truckId)
      );
      allow create: if isAppCheckVerified() && request.auth != null && isWebAdmin();
      allow update: if isAppCheckVerified() && request.auth != null && (
        isWebAdmin() ||
        maintenanceVisibleToAssignedDriver(resource.data.truckId)
      );
      allow delete: if isAppCheckVerified() && request.auth != null && isWebAdmin();
    }

    // Transactions (tax, insurance, etc.): admin only.
    match /transactions/{docId} {
      allow read: if request.auth != null && isWebAdmin();
      allow write: if isAppCheckVerified() && request.auth != null && isWebAdmin();
    }

    // Holidays: authenticated read; admin write.
    match /holidays/{holidayId} {
      allow read: if request.auth != null;
      allow write: if isAppCheckVerified() && request.auth != null && isWebAdmin();
    }

    // Leave Requests: Drivers read/create/update own; Admin read/update all.
    match /leave_requests/{requestId} {
      allow read: if request.auth != null && (
        isWebAdmin() ||
        resource.data.driverId == request.auth.uid ||
        (resource.data.get('driverId', '') != '' && get(/databases/$(database)/documents/drivers/$(resource.data.driverId)).data.get('authId', '') == request.auth.uid)
      );
      allow create: if isAppCheckVerified() && request.auth != null && (
        isWebAdmin() ||
        (request.resource.data.get('driverId', '') != '' &&
          get(/databases/$(database)/documents/drivers/$(request.resource.data.driverId)).data.get('authId', '') == request.auth.uid)
      );
      allow update: if isAppCheckVerified() && request.auth != null && (
        isWebAdmin() ||
        resource.data.driverId == request.auth.uid ||
        (resource.data.get('driverId', '') != '' && get(/databases/$(database)/documents/drivers/$(resource.data.driverId)).data.get('authId', '') == request.auth.uid)
      );
      allow delete: if isAppCheckVerified() && request.auth != null && isWebAdmin();
    }

    // Payroll: Drivers read own; Admin full access.
    match /payroll/{payrollId} {
      allow read: if request.auth != null && (
        isWebAdmin() ||
        resource.data.driverId == request.auth.uid ||
        (resource.data.get('driverId', '') != '' && get(/databases/$(database)/documents/drivers/$(resource.data.driverId)).data.get('authId', '') == request.auth.uid)
      );
      allow write: if isAppCheckVerified() && request.auth != null && isWebAdmin();
    }

    // Security audit stream: read for Security Center (admin or explicit audit capability); writes only via Admin SDK (Cloud Functions).
    match /security_events/{eventId} {
      allow read: if request.auth != null && canReadSecurityEvents();
      allow create, update, delete: if false;
    }

    // Collection-group read for Security Center: collectionGroup('mobile_installations').
    // Nested rules alone do not cover collection group queries — explicit wildcard path required.
    match /{path=**}/mobile_installations/{installId} {
      allow read: if request.auth != null && (
        isWebAdmin() ||
        (request.auth.token.get('role', '') == 'partner' &&
          resource.data.get('partnerId', '') != '' &&
          resource.data.get('partnerId', '') == request.auth.token.get('partnerScopeId', ''))
      );
    }

    // Fallback for any collection not yet explicitly listed (deny after migration).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
