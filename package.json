{
  "name": "logitrack-platform",
  "version": "3.3.1",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "node -e \"var fs=require('fs'); if(fs.existsSync('envs/.env.dev.web')) fs.copyFileSync('envs/.env.dev.web','logitrack-web/.env.local');\" && pnpm --filter logi-track run dev",
    "web": "pnpm --filter logi-track run dev",
    "web:install": "pnpm install --filter logi-track",
    "deploy:dev": "node -e \"require('fs').copyFileSync('envs/.env.dev.web','logitrack-web/.env.production')\" && pnpm --filter logi-track run deploy:dev",
    "deploy:prod": "node -e \"require('fs').copyFileSync('envs/.env.prod.web','logitrack-web/.env.production')\" && pnpm --filter logi-track run deploy:prod",
    "prepare": "husky",
    "mobile:dev": "node -e \"var fs=require('fs'); if(fs.existsSync('envs/.env.dev.mobile')) fs.copyFileSync('envs/.env.dev.mobile','logitrack-mobile/.env.dev');\"",
    "build:mobile:dev": "node -e \"require('fs').copyFileSync('envs/.env.dev.mobile','logitrack-mobile/.env.dev')\" && cd logitrack-mobile && flutter build apk --release --flavor dev --dart-define=FLAVOR=dev",
    "build:mobile:prod": "node -e \"require('fs').copyFileSync('envs/.env.prod.mobile','logitrack-mobile/.env.prod')\" && cd logitrack-mobile && flutter build apk --release --flavor prod --dart-define=FLAVOR=prod",
    "backfill:task-hub-customers:dry-run": "pnpm --filter logi-track run backfill:task-hub-customers:dry-run",
    "backfill:task-hub-customers:apply": "pnpm --filter logi-track run backfill:task-hub-customers:apply",
    "release:mobile:dev:dry-run": "pnpm --filter logi-track run release:mobile:dev:dry-run",
    "release:mobile:dev:apply": "pnpm --filter logi-track run release:mobile:dev:apply",
    "release:mobile:prod:dry-run": "pnpm --filter logi-track run release:mobile:prod:dry-run",
    "release:mobile:prod:apply": "pnpm --filter logi-track run release:mobile:prod:apply"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  },
  "dependencies": {
    "@fullcalendar/list": "^6.1.20",
    "@fullcalendar/multimonth": "^6.1.20"
  }
}